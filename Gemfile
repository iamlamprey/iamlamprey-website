source "https://rubygems.org"

# Plain Jekyll 4 rather than the github-pages gem: it installs in a minute or so
# on Windows, while the github-pages bundle drags in a large
# native-extension toolchain. If the local build ever diverges from GitHub's
# builder, swap this for `gem "github-pages", group: :jekyll_plugins`.
gem "jekyll", "~> 4.3"
gem "webrick", "~> 1.8" # jekyll serve needs webrick on Ruby 3+
